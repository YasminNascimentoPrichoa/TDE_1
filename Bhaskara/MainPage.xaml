<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bhaskara.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="25">
            
            <Label Text="Digite os valores para calcular as raízes da equação do segundo grau:" FontSize="15"/>
            <Label Text="A: " FontSize="Large"/>
            <Entry x:Name="a" Placeholder="Digite o valor de A" Keyboard="Numeric"/>
            <Label Text="B: " FontSize="Large"/>
            <Entry x:Name="b" Placeholder="Digite o valor de B" Keyboard="Numeric"/>
            <Label Text="C: " FontSize="Large"/>
            <Entry x:Name="c" Placeholder="Digite o valor de C" Keyboard="Numeric"/>
            
            <Button x:Name="btCalcularBhaskara" Text="Calcular" HorizontalOptions="Fill" Clicked="btCalcularBhaskara_Clicked"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="X1: " FontSize="Large"/>
                <Label x:Name="x1" Text="0" FontSize="Large" TextColor="Red"/>
                <Label Text="X2: " FontSize="Large"/>
                <Label x:Name="x2" Text="0" FontSize="Large" TextColor="Red"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
